# ==============================================================================
# Variables de entorno — Plataforma de Invitaciones Digitales
# ==============================================================================
#
# INSTRUCCIONES:
#   1. Copiá este archivo como .env.local:  cp .env.example .env.local
#   2. Completá los valores reales en .env.local
#   3. NUNCA subas .env.local al repositorio (ya está en .gitignore)
#   4. En Vercel, configurá estas variables en: Settings → Environment Variables
#
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE — Base de datos, autenticación y storage
# ------------------------------------------------------------------------------
# Obtenelos en: https://supabase.com → Tu Proyecto → Project Settings → API

# URL del proyecto Supabase (sin slash al final)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave pública (anon/publishable key) — segura para el frontend.
# El acceso real está controlado por las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio (service_role key) — SOLO para Server Actions y scripts.
# NUNCA la expongas al cliente (no usar NEXT_PUBLIC_).
# Permite bypassear RLS: tratar con extremo cuidado.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------------------------

# URL base de la aplicación (sin slash al final).
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com  o  https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# ADMINISTRACIÓN (opcional — solo si usás autenticación nativa sin Supabase Auth)
# ------------------------------------------------------------------------------
# Solo se usa en modo demo/local cuando Supabase no está configurado.
# En producción, la autenticación se maneja a través de Supabase Auth.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=tu-contraseña-segura

# ------------------------------------------------------------------------------
# NOTAS ADICIONALES
# ------------------------------------------------------------------------------
# · Las políticas RLS de Supabase garantizan el aislamiento entre eventos.
#   Cada evento solo puede acceder a sus propios datos aunque compartan tablas.
# · El bucket de Storage ("event-media") debe tener políticas RLS configuradas
#   para que cada evento solo acceda a su propia carpeta: eventos/{event_id}/*
# · Para habilitar QR codes nativos, no se requieren variables adicionales;
#   el código QR se genera en el servidor con la librería 'qrcode'.
