# Variables de entorno — Bianca 15 años
#
# Copiá este archivo como .env.local y completá los valores reales.
# NUNCA subas .env.local al repositorio.
#
# Para obtener estos valores:
# 1. Creá un proyecto en https://supabase.com
# 2. Andá a Project Settings → API
# 3. Copiá la URL del proyecto y la anon/public key

# URL del proyecto Supabase (sin slash al final)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon key) del proyecto Supabase
# NOTA: Esta clave es segura para el frontend; el acceso real
# está controlado por las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
